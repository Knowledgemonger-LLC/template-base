# Base .gitignore.
#
# A BASE to EXTEND. Keep it minimal: stack-specific ignores (node_modules/, __pycache__/,
# target/, build artifacts) belong with your stack tooling, not here. Append repo-specific
# entries below.

# ── OS cruft ──
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini

# ── Editor / IDE ──
.idea/
*.swp
*.swo
*~

# ── Environment / secrets ── (never commit real secrets)
.env
.env.*
!.env.example

# ── Logs ──
*.log
logs/

# ── Test / coverage output ──
coverage/
.coverage
.nyc_output/

# ── Temp ──
*.tmp
*.bak
tmp/

# ─────────────────────────────────────────────────────────────────────────────
# Repo-specific ignores below this line.
